{
	"name": "AccessControl",
	"version": "5.1",
	"author": [
		"[https://www.mediawiki.org/wiki/m:User:Want Aleš Kapica]"
	],
	"type": "parserhook",
	"url": "https://www.mediawiki.org/wiki/Extension:AccessControl",
	"descriptionmsg": "accesscontrol-desc",
	"license-name": "GPL-2.0-or-later",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadClasses": {
		"AccessControlHooks": "src/AccessControlHooks.php",
		"AccessControlInstallHooks": "src/AccessControlInstallHooks.php",
		"AccessControlApiQueryImageInfo": "src/AccessControlApiQueryImageInfo.php",
		"AccessControlApiQueryAllImages": "src/AccessControlApiQueryAllImages.php",
		"AccessControlPdfHandler": "src/AccessControlPdfHandler.php",
		"AccessControlGroupPermissionsLookup": "src/AccessControlGroupPermissionsLookup.php"
	},
	"MessagesDirs": {
		"AccessControl": [
			"i18n"
		]
	},
	"config": {
		"AdminCanReadAll": {
			"value": true,
			"description": "Sysop users can read all restricted pages"
		},
		"AccessControlAllowTextSnippetInSearchResultsForAll": {
			"value": false,
			"description": "Allow to show text snippet of protected pages in search result even user has no rights to read"
		}
	},
	"HookHandlers": {
		"AccessControlHooks": {
			"class": "AccessControlHooks",
			"services": [
				"MainConfig",
				"UserGroupManager",
				"ConnectionProvider",
				"WikiPageFactory",
				"TitleFactory"
			]
		},
		"AccessControlInstallHooks": {
			"class": "AccessControlInstallHooks"
		}
	},
	"Hooks": {
		"getUserPermissionsErrors": "AccessControlHooks",
		"ParserFirstCallInit": "AccessControlHooks",
		"BeforeParserFetchTemplateRevisionRecord": "AccessControlHooks",
		"BeforeParserFetchFileAndTitle": "AccessControlHooks",
		"ParserAfterTidy": "AccessControlHooks",
		"ParserOptionsRegister": "AccessControlHooks",
		"OutputPageParserOutput": "AccessControlHooks",
		"LinksUpdate": "AccessControlHooks",
		"LoadExtensionSchemaUpdates": "AccessControlInstallHooks",
		"MediaWikiServices": "AccessControlInstallHooks",
		"ShowSearchHit": "AccessControlHooks",
		"ApiQuery::moduleManager": "AccessControlHooks",
		"BitmapHandlerTransform": "AccessControlHooks",
		"LinkerMakeMediaLinkFile": "AccessControlHooks",
		"SpecialPageBeforeExecute": "AccessControlHooks"
	},
	"manifest_version": 2
}
